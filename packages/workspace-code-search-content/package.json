{
  "name": "@dsh-plugin/workspace-code-search-content",
  "version": "0.1.0",
  "description": "Workspace grep content search provider",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@dsh-plugin/workspace-code-search": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@dsh-plugin/workspace-code-search": "workspace:*",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
